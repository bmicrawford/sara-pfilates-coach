{
  "name": "sara-pfilates-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite --port 43147 --host",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build && cp dist/index.html dist/200.html",
    "preview": "vite preview --port 43147 --host",
    "smoke:replies": "node --experimental-strip-types src/lib/replies.smoke.ts",
    "smoke:ask": "node server/askGrok.smoke.mjs",
    "smoke:ask-copy": "node --experimental-strip-types src/lib/askSara.smoke.ts",
    "smoke:speech": "node --experimental-strip-types src/lib/pfilatesSpeech.smoke.ts",
    "smoke:speak": "node server/speakSara.smoke.mjs",
    "smoke:diary": "node --experimental-strip-types src/lib/diary.smoke.ts",
    "smoke:verify-api": "node scripts/verify-sara-api.mjs --self-test",
    "verify:ask-api": "node scripts/verify-sara-api.mjs"
  },
  "dependencies": {
    "@d-id/client-sdk": "^2.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3"
  }
}
