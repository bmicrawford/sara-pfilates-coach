# Server only — never prefix with VITE_ (that would leak into the browser bundle).
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_TTS_VOICE=ara
SARA_API_PORT=8787

# Optional talking-head video (D-ID). Same locked still + neural audio.
# Without this key, Ask Sara still speaks (xAI ara) and the mouth animates
# on the still. Collect this one key to finish vendor lip-sync video:
DID_API_KEY=
SARA_AVATAR_URL=https://sara-pfilates-coach.surge.sh/avatar/sara-default.png

# Frontend: public origin of the Ask Sara proxy (no trailing slash).
# Local: leave empty so Vite proxies /ask /speak /talk → http://127.0.0.1:8787
# Phone demo: https://<your-worker>.workers.dev  or the cloudflared tunnel
VITE_SARA_API_URL=
