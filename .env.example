# Server only — never prefix with VITE_ (that would leak into the browser bundle).
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_TTS_VOICE=ara
SARA_API_PORT=8787

# D-ID talking-head video is paused (product). Leave unset.
# Ask Sara still speaks (xAI ara) and the mouth animates on the still.
DID_API_KEY=
SARA_AVATAR_URL=https://sara-pfilates-coach.surge.sh/avatar/sara-default.png

# Frontend: public origin of the Ask Sara proxy (no trailing slash).
# Local: leave empty so Vite proxies /ask /speak /talk → http://127.0.0.1:8787
# Phone demo (durable): https://sara-pfilates-ask.<account>.workers.dev
# Never bake *.trycloudflare.com — tunnels die and the Surge demo cannot resolve them.
VITE_SARA_API_URL=
