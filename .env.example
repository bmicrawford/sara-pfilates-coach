# Server only — never prefix with VITE_ (that would leak into the browser bundle).
XAI_API_KEY=
XAI_MODEL=grok-4.6
SARA_API_PORT=8787

# Frontend: public origin of the Ask Sara proxy (no trailing slash).
# Local: leave empty so Vite proxies /ask → http://127.0.0.1:8787
# Phone demo: https://<your-worker>.workers.dev
VITE_SARA_API_URL=
