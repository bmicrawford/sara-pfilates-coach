# Server only — never prefix with VITE_ (that would leak into the browser bundle).
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_TTS_VOICE=ara
SARA_API_PORT=8787

# Optional D-ID Agents stream. Leave unset locally — Ask Sara still speaks (xAI ara).
# Production Worker already has DID_API_KEY — never put the value in this file.
DID_API_KEY=
# Photo agent id (agt_...) created once in D-ID Studio / POST /agents. Not a secret key,
# but still server-only so the Vite bundle does not hard-code it.
DID_AGENT_ID=
SARA_AVATAR_URL=https://sara-pfilates.surge.sh/avatar/sara-default.png

# Worker/Node only. Zapier sends this on POST /redeem/mint. Never prefix with VITE_.
REDEEM_MINT_SECRET=
# Origin written into minted /r/:token links.
SARA_PUBLIC_ORIGIN=https://sara-pfilates.surge.sh

# Frontend: public origin of the Ask Sara proxy (no trailing slash).
# Local: leave empty so Vite proxies /ask /speak /talk /stream → http://127.0.0.1:8787
# Phone demo (durable): https://sara-pfilates-ask.<account>.workers.dev
# Never bake *.trycloudflare.com — tunnels die and the Surge demo cannot resolve them.
VITE_SARA_API_URL=
